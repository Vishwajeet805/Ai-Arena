# Local development defaults only. Never put production credentials here.
POSTGRES_DB=arena
POSTGRES_USER=arena
POSTGRES_PASSWORD=local_dev_change_me
DATABASE_URL=postgresql://arena:local_dev_change_me@db:5432/arena
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Optional real target: authorized OpenAI-compatible chat-completions endpoint.
# These variables are read only by the backend; never prefix them with NEXT_PUBLIC_.
# Leave ARENA_LLM_API_KEY empty until configured in your local secret environment.
ARENA_LLM_BASE_URL=https://api.openai.com/v1
ARENA_LLM_MODEL=replace-with-authorized-model
ARENA_LLM_API_KEY=
ARENA_LLM_TIMEOUT_SECONDS=8
